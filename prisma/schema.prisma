generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String           @id @default(cuid())
  email        String           @unique
  password     String
  name         String?
  createdAt    DateTime         @default(now())
  applications JobApplication[]
}

enum ApplicationStatus {
  POR_APLICAR
  APLICADO
  ENTREVISTA
  OFERTA
  RECHAZADO
}

/// Datos que puede completar el extractor de ofertas (POST /ai/extract-job).
/// "unknown" del extractor se guarda como null: para la tarjeta, "no se sabe"
/// y "no se cargó" son lo mismo.
enum Modality {
  remote
  hybrid
  onsite
}

enum Seniority {
  junior
  mid
  senior
}

enum SalaryPeriod {
  month
  year
  hour
}

model JobApplication {
  id            String             @id @default(cuid())
  company       String
  role          String
  status        ApplicationStatus  @default(POR_APLICAR)
  link          String?
  notes         String?
  appliedAt     DateTime?
  // Campos de la oferta, todos opcionales (extractor o carga manual).
  location       String?
  modality       Modality?
  seniority      Seniority?
  salaryMin      Int?
  salaryMax      Int?
  salaryCurrency String?
  salaryPeriod   SalaryPeriod?
  stack          String[]          @default([])
  deadline       DateTime?
  summary        String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  statusChanges StatusChange[]
}

/// Historial de transiciones de estado de una postulación — alimenta el
/// embudo de conversión y el tiempo promedio por estado en /account (Reportes).
model StatusChange {
  id            String              @id @default(cuid())
  application   JobApplication      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  applicationId String
  fromStatus    ApplicationStatus?
  toStatus      ApplicationStatus
  changedAt     DateTime            @default(now())

  @@index([applicationId])
}
